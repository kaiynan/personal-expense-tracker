# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env!

# Token dari @BotFather
TELEGRAM_BOT_TOKEN=

# User ID Telegram yang boleh memakai bot, dipisah koma (cek lewat @userinfobot)
ALLOWED_TELEGRAM_IDS=

# Lokasi database, relatif terhadap root proyek (opsional)
DB_PATH=data/expense_tracker.db

# DEBUG, INFO, WARNING, ERROR (opsional)
LOG_LEVEL=INFO

# Kunci rahasia sesi Web Dashboard (wajib diisi acak di production)
SECRET_KEY=ganti-dengan-kunci-rahasia-panjang-dan-acak-di-production
